DROP SCHEMA IF EXISTS biblioteca CASCADE;
DROP SCHEMA IF EXISTS heladeria  CASCADE;
DROP SCHEMA IF EXISTS ferreteria CASCADE;
DROP SCHEMA IF EXISTS cine       CASCADE;
DROP SCHEMA IF EXISTS farmacia   CASCADE;

DROP ROLE IF EXISTS bibliotecario;
DROP ROLE IF EXISTS heladero;
DROP ROLE IF EXISTS ferretero;
DROP ROLE IF EXISTS cajero_cine;
DROP ROLE IF EXISTS farmaceutico;


-- 1. SCHEMAS NUEVOS (5)
-- ---------------------------------------------------------------------
CREATE SCHEMA biblioteca;
CREATE SCHEMA heladeria;
CREATE SCHEMA ferreteria;
CREATE SCHEMA cine;
CREATE SCHEMA farmacia;


-- 2. TABLAS (4 por schema)
-- ---------------------------------------------------------------------

-- ===== BIBLIOTECA =====
CREATE TABLE biblioteca.autores (
    id            INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre        VARCHAR(100) NOT NULL,
    nacionalidad  VARCHAR(50)  NOT NULL
);

CREATE TABLE biblioteca.libros (
    id          INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    titulo      VARCHAR(150) NOT NULL,
    autor_id    INT NOT NULL REFERENCES biblioteca.autores(id),
    anio        INT NOT NULL,
    ejemplares  INT NOT NULL DEFAULT 1
);

CREATE TABLE biblioteca.socios (
    id              INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre          VARCHAR(100) NOT NULL,
    correo          VARCHAR(100) NOT NULL UNIQUE,
    fecha_registro  DATE NOT NULL DEFAULT CURRENT_DATE
);

CREATE TABLE biblioteca.prestamos (
    id                INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    libro_id          INT NOT NULL REFERENCES biblioteca.libros(id),
    socio_id          INT NOT NULL REFERENCES biblioteca.socios(id),
    fecha_prestamo    DATE NOT NULL,
    fecha_devolucion  DATE
);

-- ===== HELADERIA =====
CREATE TABLE heladeria.sabores (
    id         INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre     VARCHAR(50) NOT NULL UNIQUE,
    es_lacteo  BOOLEAN NOT NULL
);

CREATE TABLE heladeria.productos (
    id        INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre    VARCHAR(80) NOT NULL,
    sabor_id  INT NOT NULL REFERENCES heladeria.sabores(id),
    tamano    VARCHAR(30) NOT NULL,
    precio    NUMERIC(8,2) NOT NULL
);

CREATE TABLE heladeria.clientes (
    id        INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre    VARCHAR(100) NOT NULL,
    telefono  VARCHAR(20)
);

CREATE TABLE heladeria.ventas (
    id           INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    cliente_id   INT NOT NULL REFERENCES heladeria.clientes(id),
    producto_id  INT NOT NULL REFERENCES heladeria.productos(id),
    cantidad     INT NOT NULL,
    fecha        DATE NOT NULL,
    total        NUMERIC(10,2) NOT NULL
);

-- ===== FERRETERIA =====
CREATE TABLE ferreteria.categorias (
    id      INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre  VARCHAR(80) NOT NULL UNIQUE
);

CREATE TABLE ferreteria.proveedores (
    id        INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre    VARCHAR(100) NOT NULL,
    telefono  VARCHAR(20)
);

CREATE TABLE ferreteria.productos (
    id            INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre        VARCHAR(100) NOT NULL,
    categoria_id  INT NOT NULL REFERENCES ferreteria.categorias(id),
    proveedor_id  INT NOT NULL REFERENCES ferreteria.proveedores(id),
    precio        NUMERIC(10,2) NOT NULL,
    stock         INT NOT NULL DEFAULT 0
);

CREATE TABLE ferreteria.ventas (
    id           INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    producto_id  INT NOT NULL REFERENCES ferreteria.productos(id),
    cantidad     INT NOT NULL,
    fecha        DATE NOT NULL,
    total        NUMERIC(10,2) NOT NULL
);

-- ===== CINE =====
CREATE TABLE cine.peliculas (
    id             INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    titulo         VARCHAR(150) NOT NULL,
    genero         VARCHAR(50)  NOT NULL,
    duracion_min   INT NOT NULL,
    clasificacion  VARCHAR(5)   NOT NULL
);

CREATE TABLE cine.salas (
    id         INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre     VARCHAR(30) NOT NULL UNIQUE,
    capacidad  INT NOT NULL,
    tipo       VARCHAR(20) NOT NULL
);

CREATE TABLE cine.funciones (
    id           INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    pelicula_id  INT NOT NULL REFERENCES cine.peliculas(id),
    sala_id      INT NOT NULL REFERENCES cine.salas(id),
    horario      TIMESTAMP NOT NULL,
    precio       NUMERIC(6,2) NOT NULL
);

CREATE TABLE cine.boletos (
    id            INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    funcion_id    INT NOT NULL REFERENCES cine.funciones(id),
    asiento       VARCHAR(5) NOT NULL,
    cliente       VARCHAR(100) NOT NULL,
    fecha_compra  DATE NOT NULL
);

-- ===== FARMACIA =====
CREATE TABLE farmacia.proveedores (
    id        INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre    VARCHAR(100) NOT NULL,
    telefono  VARCHAR(20)
);

CREATE TABLE farmacia.medicamentos (
    id               INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre           VARCHAR(100) NOT NULL,
    principio_activo VARCHAR(100) NOT NULL,
    proveedor_id     INT NOT NULL REFERENCES farmacia.proveedores(id),
    precio           NUMERIC(8,2) NOT NULL,
    stock            INT NOT NULL DEFAULT 0,
    requiere_receta  BOOLEAN NOT NULL DEFAULT FALSE
);

CREATE TABLE farmacia.clientes (
    id        INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    nombre    VARCHAR(100) NOT NULL,
    telefono  VARCHAR(20)
);

CREATE TABLE farmacia.ventas (
    id              INT GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
    medicamento_id  INT NOT NULL REFERENCES farmacia.medicamentos(id),
    cliente_id      INT NOT NULL REFERENCES farmacia.clientes(id),
    cantidad        INT NOT NULL,
    fecha           DATE NOT NULL,
    total           NUMERIC(10,2) NOT NULL
);


