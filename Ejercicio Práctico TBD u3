-- 5. PERMISOS (por schema, por tabla y por acción)
--    Acciones: SELECT = consultar, INSERT = insertar,
--              UPDATE = actualizar, DELETE = eliminar


-- Nadie (PUBLIC) puede entrar a los schemas por defecto
REVOKE ALL ON SCHEMA biblioteca, heladeria, ferreteria, cine, farmacia FROM PUBLIC;

-- ===== bibliotecario -> schema BIBLIOTECA =====
GRANT USAGE ON SCHEMA biblioteca TO bibliotecario;
GRANT SELECT                         ON biblioteca.autores   TO bibliotecario;  -- solo consultar
GRANT SELECT, INSERT, UPDATE         ON biblioteca.libros    TO bibliotecario;  -- sin eliminar
GRANT SELECT, INSERT, UPDATE         ON biblioteca.socios    TO bibliotecario;  -- sin eliminar
GRANT SELECT, INSERT, UPDATE, DELETE ON biblioteca.prestamos TO bibliotecario;  -- control total

-- ===== heladero -> schema HELADERIA =====
GRANT USAGE ON SCHEMA heladeria TO heladero;
GRANT SELECT                 ON heladeria.sabores   TO heladero;  -- solo consultar
GRANT SELECT, UPDATE         ON heladeria.productos TO heladero;  -- consultar y cambiar precios
GRANT SELECT, INSERT         ON heladeria.clientes  TO heladero;  -- consultar y registrar
GRANT SELECT, INSERT, UPDATE ON heladeria.ventas    TO heladero;  -- sin eliminar ventas

-- ===== ferretero -> schema FERRETERIA =====
GRANT USAGE ON SCHEMA ferreteria TO ferretero;
GRANT SELECT                         ON ferreteria.categorias  TO ferretero;
GRANT SELECT                         ON ferreteria.proveedores TO ferretero;
GRANT SELECT, INSERT, UPDATE, DELETE ON ferreteria.productos   TO ferretero;  -- control total
GRANT SELECT, INSERT                 ON ferreteria.ventas      TO ferretero;  -- no modifica ventas

-- ===== cajero_cine -> schema CINE =====
GRANT USAGE ON SCHEMA cine TO cajero_cine;
GRANT SELECT                 ON cine.peliculas TO cajero_cine;
GRANT SELECT                 ON cine.salas     TO cajero_cine;
GRANT SELECT                 ON cine.funciones TO cajero_cine;
GRANT SELECT, INSERT, DELETE ON cine.boletos   TO cajero_cine;  -- vende y cancela boletos

-- ===== farmaceutico -> schema FARMACIA =====
GRANT USAGE ON SCHEMA farmacia TO farmaceutico;
GRANT SELECT                 ON farmacia.proveedores   TO farmaceutico;
GRANT SELECT, UPDATE         ON farmacia.medicamentos  TO farmaceutico;  -- actualiza stock/precio
GRANT SELECT, INSERT, UPDATE ON farmacia.clientes      TO farmaceutico;
GRANT SELECT, INSERT         ON farmacia.ventas        TO farmaceutico;  -- registra ventas
